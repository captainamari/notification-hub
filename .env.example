# Required. Generate with: openssl rand -hex 32
API_TOKEN=replace-with-a-long-random-token

APP_NAME=notification-hub
ENVIRONMENT=production
LOG_LEVEL=INFO
DEFAULT_CHANNEL=default
RATE_LIMIT_PER_MINUTE=60

# Telegram: easiest setup. Multiple chat IDs can be comma-separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Advanced alternative: provide the complete Apprise URL instead.
TELEGRAM_APPRISE_URL=

# Email / SMTP. SMTP_USE_TLS=true uses Apprise's mailtos:// transport.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
SMTP_USE_TLS=true
# Advanced alternative: provide the complete Apprise URL instead.
EMAIL_APPRISE_URL=

# Routes. Values are comma-separated provider aliases: telegram,email
ROUTE_DEFAULT=telegram
ROUTE_OPS=telegram
ROUTE_TRADING=telegram
ROUTE_WARNING=telegram,email
ROUTE_CRITICAL=telegram,email
